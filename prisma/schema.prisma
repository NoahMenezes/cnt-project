generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  publicKey String   // RSA Public Key (Base64 SPKI)
  createdAt DateTime @default(now())
  sentFiles     File[]    @relation("SentFiles")
  receivedFiles File[]    @relation("ReceivedFiles")
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model File {
  id             String   @id @default(cuid())
  filename       String
  senderId       String
  receiverId     String
  encryptedKey   String   // AES Key wrapped with Receiver's RSA Public Key
  encryptedFileUrl String // Placeholder for storage URL
  iv             String
  sender         User     @relation("SentFiles", fields: [senderId], references: [clerkId])
  receiver       User     @relation("ReceivedFiles", fields: [receiverId], references: [clerkId])
  createdAt      DateTime @default(now())
}

model Message {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  content        String   // AES-GCM Encrypted
  encryptedKey   String   // AES Key wrapped with Receiver's RSA Public Key
  iv             String
  sender         User     @relation("SentMessages", fields: [senderId], references: [clerkId])
  receiver       User     @relation("ReceivedMessages", fields: [receiverId], references: [clerkId])
  createdAt      DateTime @default(now())
}
